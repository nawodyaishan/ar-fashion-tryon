# Active garment/try-on API. Public values are visible in the browser.
NEXT_PUBLIC_GARMENT_API_BASE=http://127.0.0.1:5000

# Optional browser upload path; leave both empty to use direct API uploads.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Legacy client bases: these do not configure the API's Gradio Space.
# Set explicitly to avoid accidental hosted defaults while developing.
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:5000
NEXT_PUBLIC_VTON_API_BASE=http://127.0.0.1:8000
# Legacy keypoint/process_images endpoints are not implemented by the active API.
# Do not place HF tokens or Cloudinary API secrets in NEXT_PUBLIC_ variables.
